#!/usr/bin/env python3
import os
import io
import sys
import json
import argparse
import subprocess
from pathlib import Path
from registry import registry


def main():
    parser = argparse.ArgumentParser(description="Complete code analysis and generate JSON output")
    parser.add_argument("-o", "--output", default="/root/analysis.json", help="Output JSON file path")
    parser.add_argument("-f", "--force", action="store_true", help="Force completion without validation")
    # Handle the case where model passes literal parameter names
    cleaned_args = []
    skip_next = False
    for i, arg in enumerate(sys.argv[1:]):
        if skip_next:
            skip_next = False
            continue
        # Handle literal parameter examples from model
        if arg == "[-o" and i + 1 < len(sys.argv[1:]) and sys.argv[i + 2] == "OUTPUT_FILE]":
            # Skip this literal example
            skip_next = True
            continue
        elif arg == "[-f]" or arg == "OUTPUT_FILE]" or arg.startswith("[-"):
            # Skip literal examples
            continue
        else:
            cleaned_args.append(arg)
    # Parse cleaned arguments
    try:
        args = parser.parse_args(cleaned_args)
    except SystemExit:
        # If parsing still fails, use defaults
        args = parser.parse_args([])
    repo_root = registry.get("ROOT", os.getenv("ROOT"))
    assert repo_root
    # Check if we have analysis results in the registry or from previous steps
    analysis_results = registry.get("ANALYSIS_RESULTS", None)
    # Get completion stage
    complete_review_messages = registry.get("ANALYSIS_COMPLETE_MESSAGES", [])
    n_stages = len(complete_review_messages)
    current_stage = registry.get("ANALYSIS_STAGE", 0)
    if not args.force and current_stage != n_stages and complete_review_messages:
        # Show review message and wait for final JSON input
        message = complete_review_messages[current_stage]
        message = message.replace("{{problem_statement}}", registry.get("PROBLEM_STATEMENT", ""))
        registry["ANALYSIS_STAGE"] = current_stage + 1
        print(message)
        sys.exit(0)
    # Look for JSON analysis in recent output or registry
    json_content = None
    # Try to extract JSON from registry first
    if analysis_results:
        json_content = analysis_results
    else:
        # Try to find JSON in the last command output or current directory
        possible_json_files = [Path(args.output), Path("/root/analysis.json"), Path(repo_root) / "analysis.json", Path("/tmp/analysis.json")]
        for json_file in possible_json_files:
            if json_file.exists():
                try:
                    json_content = json_file.read_text()
                    print(f"Found analysis file: {json_file}")
                    break
                except Exception as e:
                    print(f"Error reading {json_file}: {e}")
                    continue
    # If still no JSON found, prompt for it
    if not json_content:
        print("No analysis JSON file found. Please create one first.")
        print("Expected locations checked:")
        for path in possible_json_files:
            print(f"  - {path}")
        print("\nExpected JSON format:")
        print(json.dumps({
            "analysis_summary": "Brief description of the issue and approach",
            "relevant_files": [
                {
                    "file_path": "path/to/file.py",
                    "relevance_reason": "Contains the main logic for the reported functionality",
                    "key_functions": ["function1", "function2"],
                    "code_snippets": [
                        {
                            "lines": "45-50",
                            "content": "def example_function():\\n    # relevant code here",
                            "description": "Function that handles the core logic"
                        }
                    ]
                }
            ],
            "potential_root_causes": [
                {
                    "description": "Specific issue description",
                    "file_path": "path/to/file.py",
                    "code_snippet": [
                        {
                            "content": "actual code content",
                            "description": "Why this causes problems"
                        }
                    ]
                }
            ],
            "recommended_investigation_order": [
                "path/to/primary_file.py",
                "path/to/secondary_file.py"
            ],
            "related_test_files": ["path/to/test_file.py"],
            "dependencies": ["module1", "module2"]
        }, indent=2))
        print("\nPlease create the JSON file first, then run 'analysis_complete' again.")
        sys.exit(0)
    # Validate JSON content
    try:
        analysis_data = json.loads(json_content) if isinstance(json_content, str) else json_content
        # Basic validation of required fields
        required_fields = ["analysis_summary", "relevant_files",  "potential_root_causes", "recommended_investigation_order"]
        missing_fields = [field for field in required_fields if field not in analysis_data]
        if missing_fields:
            print(f"Error: Missing required fields in analysis JSON: {missing_fields}")
            sys.exit(1)
    except json.JSONDecodeError as e:
        print(f"Error: Invalid JSON format - {e}")
        sys.exit(1)
    # Save the analysis results to the final output location
    output_path = Path(args.output)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    # Add metadata
    # analysis_data["metadata"] = {"repo_root": repo_root, "problem_statement": registry.get("PROBLEM_STATEMENT", ""), "analysis_tool_version": "1.0.0"}
    # Write final JSON
    with open(output_path, 'w', encoding='utf-8') as f:
        json.dump(analysis_data, f, indent=2, ensure_ascii=False)
    # Signal completion to SWE-agent
    print("<<SWE_AGENT_ANALYSIS_COMPLETE>>")
    print(f"Analysis saved to: {output_path}")
    print("Analysis Summary:")
    print(f"- Found {len(analysis_data.get('relevant_files', []))} relevant files")
    print(f"- Identified {len(analysis_data.get('potential_root_causes', []))} potential root causes")
    print(f"- Recommended investigation order: {len(analysis_data.get('recommended_investigation_order', []))} files")
    print("<<SWE_AGENT_ANALYSIS_COMPLETE>>")

if __name__ == "__main__":
    # Handle encoding issues similar to the original tool
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8")
    main()